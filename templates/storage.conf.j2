# Ansible managed - do not edit
{% if podman_storage_defaults is defined -%}
    {%- set defaults = podman_storage_defaults -%}
{%- else -%}
    {%- set defaults = {} -%}
{%- endif -%}

{%- if podman_storage_config is defined -%}
    {%- set config = podman_storage_config -%}
{%- else -%}
    {%- set config = {} -%}
{%- endif -%}

{#- A null removes what the defaults set, a key or a whole table. -#}
{%- set data = defaults | combine(config, recursive=true) -%}
{%- set storage = data.storage | default({}, true) -%}
{%- set options = storage.options | default({}, true) -%}
{#- The driver sections of [storage.options], rendered on their own below
    rather than as keys of the table that holds them. -#}
{%- set sections = ['aufs', 'btrfs', 'thinpool', 'overlay', 'vfs', 'zfs'] -%}
{#- A table is written only when it holds a key of its own. An empty [storage]
    is not harmless : podman warns that no driver is set and picks one itself. -#}
{%- set storage_keys = storage | dict2items | rejectattr('value', 'none') | map(attribute='key') | reject('eq', 'options') | list -%}
{%- set option_keys = options | dict2items | rejectattr('value', 'none') | map(attribute='key') | reject('in', sections) | list %}
{% if storage_keys %}

[storage]
{% for key in storage_keys %}
{% if storage[key] is string %}
{{ key }} = "{{ storage[key] }}"
{% elif storage[key] is boolean %}
{{ key }} = {{ storage[key] | lower }}
{% else %}
{{ key }} = {{ storage[key] }}
{% endif %}
{% endfor %}
{% endif %}
{% if option_keys %}

[storage.options]
{% for key in option_keys %}
{% if options[key] is string %}
{{ key }} = "{{ options[key] }}"
{% elif options[key] is boolean %}
{{ key }} = {{ options[key] | lower }}
{% else %}
{{ key }} = {{ options[key] }}
{% endif %}
{% endfor %}
{% endif %}
{% for section in sections if options[section] | default(none) is mapping and options[section].values() | reject('none') | list %}

[storage.options.{{ section }}]
{% for key, value in options[section].items() if value is not none %}
{% if value is string %}
{{ key }} = "{{ value }}"
{% elif value is boolean %}
{{ key }} = {{ value | lower }}
{% else %}
{{ key }} = {{ value }}
{% endif %}
{% endfor %}
{% endfor %}
