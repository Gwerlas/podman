{#
  A spec without a destination is an anonymous volume : nothing to pre-create,
  and the colon is the one thing we can read off the template itself. What the
  source turns out to be is only knowable once the shell has expanded it, so
  the classification is left to the emitted function below.
-#}
{% macro bind_source(spec) %}
{% if ':' in spec %}
podman_wrapper_bind_source "{{ spec.split(':') | first }}"
{% endif %}
{% endmacro %}
{#
  /bin/sh, not `env sh` : the interpreter of a root-installed wrapper must not
  depend on the caller's PATH. What follows stays POSIX, and carries no
  `set -u` -- the ssh_auth_sock extra reads $SSH_AUTH_SOCK with no default.
-#}
#!/bin/sh
# Ansible managed - do not edit

{% set data = podman_wrappers_values | combine(wrapper) %}
{% set wrapper = data %}
{% if not wrapper.can_extends | default(false) %}
# Reset options to prevent user's customizations
CONTAINER_OPTS=""
{% endif %}

{% if 'volume' in wrapper and 'volume' in podman_wrappers_autofill %}
{#
  "If the source does not exist, Podman returns an error. Users must
  pre-create the source files or directories." -- podman-run(1), --volume :
  https://docs.podman.io/en/latest/markdown/podman-run.1.html
  The same option classifies what it is given : a source that does not begin
  with a . or / is the name of a named volume, podman's own to create. The
  case below is that rule, applied where podman applies it -- to the expanded
  value -- so a variable holding either one lands where podman would put it.
  `install -d` is left to fail on a path the user cannot create, right before
  podman reports the same mount as missing.
-#}
podman_wrapper_bind_source() {
  case "$1" in
    [/.]*) [ -e "$1" ] || install -d "$1" ;;
  esac
}

{% endif %}
# Podman options
# https://docs.ansible.com/ansible/latest/collections/containers/podman/podman_container_module.html
{% for key in podman_wrappers_autofill %}
{% if key in wrapper %}
{% set parameter = key | replace('_', '-') %}
{% set value = wrapper[key] %}
{% if value is mapping %}
{% for k, v in value.items() %}
CONTAINER_OPTS="$CONTAINER_OPTS --{{ parameter }} {{ k }}={{ v }}"
{% endfor %}
{% elif value is iterable and not value is string %}
{% for i in value %}
{% if key == 'volume' %}
{{ bind_source(i) -}}
{% endif %}
CONTAINER_OPTS="$CONTAINER_OPTS --{{ parameter }} {{ i }}"
{% endfor %}
{% elif value is boolean %}
{% if value %}
CONTAINER_OPTS="$CONTAINER_OPTS --{{ parameter }}"
{% endif %}
{% else %}
{% if key == 'volume' %}
{{ bind_source(value) -}}
{% endif %}
CONTAINER_OPTS="$CONTAINER_OPTS --{{ parameter }} {{ value }}"
{% endif %}
{% endif %}
{% endfor %}

{% if 'wrapper_extras' in wrapper %}
# Wrapper's extras snippets
{% if wrapper.wrapper_extras.ssh_auth_sock | default(false) %}
# SSH client authentication socket
if [ ! -z "$SSH_AUTH_SOCK" ]; then
  CONTAINER_OPTS="$CONTAINER_OPTS -e SSH_AUTH_SOCK -v $SSH_AUTH_SOCK:$SSH_AUTH_SOCK -v $HOME/.ssh:/root/.ssh"
fi
{% endif %}

{% if wrapper.wrapper_extras.podman_socket | default(false) %}
# Podman socket
systemctl is-active --user podman.socket > /dev/null ||
systemctl start --user podman.socket

CONTAINER_OPTS="$CONTAINER_OPTS --privileged"
CONTAINER_OPTS="$CONTAINER_OPTS -v /sys/fs/cgroup:/sys/fs/cgroup"
CONTAINER_OPTS="$CONTAINER_OPTS -v $XDG_RUNTIME_DIR/podman/podman.sock:/run/podman/podman.sock"
{% endif %}

{% if 'env_patterns' in wrapper.wrapper_extras %}
# Sharing environment variables by patterns
{% for pattern in wrapper.wrapper_extras.env_patterns | default([]) %}
for envvar in $(env | grep '{{ pattern }}' | cut -d= -f1); do
  CONTAINER_OPTS="$CONTAINER_OPTS -e $envvar"
done
{% endfor %}
{% endif %}

{% if wrapper.wrapper_extras.openstack_cli | default(false) %}
# Openstack clients
for envvar in $(env | grep '^OS_' | cut -d= -f1); do
  CONTAINER_OPTS="$CONTAINER_OPTS -e $envvar"
done

for path in .config/openstack .neutronclient .novaclient; do
  install -d $HOME/$path
  CONTAINER_OPTS="$CONTAINER_OPTS -v $HOME/$path:/root/$path"
done

if [ ! -z "${OS_CACERT:-}" ]; then
  CONTAINER_OPTS="$CONTAINER_OPTS -v $OS_CACERT:$OS_CACERT:ro"
fi
{% endif %}

{% if wrapper.wrapper_extras.same_pwd | default(false) %}
# Same working directory as the user
CONTAINER_OPTS="$CONTAINER_OPTS -e PWD -v $PWD:$PWD -w $PWD"
{% endif %}
{% endif %}

# Run
{{ wrapper.executable | default('podman') }} run $CONTAINER_OPTS {{ wrapper.image }} {{ wrapper.command | default('') }} "$@"
