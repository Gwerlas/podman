# Ansible managed - do not edit
{%
    set defaults = (
        (
            default_registries_config |
            default({})
        ) |
        combine(
                {'unqualified-search-registries': ['docker.io']}
                if podman_mimic_docker
                else {}
            ,
            recursive=true
        )
    )
%}
{% set config = podman_registries_config | default({}) %}

{#- A null removes what the defaults set. -#}
{%- set data = defaults | combine(config, recursive=true) %}

{% for key, value in data.items() if value is not none %}
{% if value is string %}
{{ key }} = "{{ value }}"
{% elif value is boolean %}
{{ key }} = {{ value | lower }}
{% elif key != "registry" %}
{{ key }} = {{ value }}
{% endif %}
{% endfor %}

{% if data.registry | default([], true) %}
{% for registry in data.registry %}
[[registry]]
{% for key, value in registry.items() if value is not none %}
{% if value is string %}
{{ key }} = "{{ value }}"
{% elif value is boolean %}
{{ key }} = {{ value | lower }}
{% elif key != "mirror" %}
{{ key }} = {{ value }}
{% endif %}
{% endfor %}
{% if registry.mirror | default([], true) %}
{% for mirror in registry.mirror %}
[[registry.mirror]]
{% for key, value in mirror.items() if value is not none %}
{% if value is string %}
{{ key }} = "{{ value }}"
{% elif value is boolean %}
{{ key }} = {{ value | lower }}
{% else %}
{{ key }} = {{ value }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
