# Ansible managed - do not edit
{% if _podman_containers_defaults is defined -%}
    {%- set defaults = _podman_containers_defaults -%}
{%- else -%}
    {%- set defaults = {} -%}
{%- endif -%}

{%- if podman_containers_config is defined -%}
    {%- set config = podman_containers_config -%}
{%- else -%}
    {%- set config = {} -%}
{%- endif -%}

{#- A null removes what the defaults set, a key or a whole table. -#}
{%- set data = defaults | combine(config, recursive=true) %}

{% for section in ['containers', 'engine', 'network', 'machine', 'service_destinations', 'secret'] %}
{% set table = data[section] | default({}, true) %}
{% if table.values() | reject('none') | list %}
[{{ section }}]
{% for key, value in table.items() if value is not none %}
{% if value is string %}
{{ key }} = "{{ value }}"
{% elif value is boolean %}
{{ key }} = {{ value | lower }}
{% else %}
{{ key }} = {{ value }}
{% endif %}
{% endfor %}

{% endif %}
{% endfor %}
